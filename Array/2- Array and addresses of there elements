//Array and addresses of there elements;
#include <stdio.h>
int main()
{
   int a[4]={10,20,30,40};
   printf("size of array a is: %d\n",sizeof(a));
   printf("size of one element of array a is: %d\n",sizeof(a[0]));
   printf("%u\n",&a);//&a and &a[0] holds same address;
   printf("%u\n",&a[0]);
   printf("%u\n",&a[1]);
   printf("%u\n",&a[2]);
   printf("%u\n",&a[3]);
    return 0;
}
