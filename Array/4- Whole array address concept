// array element location and whole array
#include <stdio.h>

int main()
{
    int a[4]={10,20,30,40};
    printf("%d\n",sizeof(int));
    printf("%d\n",sizeof(a));
    printf("%u\n",a);
    printf("%u\n",a+1);
    printf("%u\n",&a);
    printf("%u",&a+1);

    return 0;
}
