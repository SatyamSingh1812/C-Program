// count the no. of digit using recursion
#include <stdio.h>
int fun(int x){
    if(x>=-9 && x<=9 )
        return 1;
    else 
        return 1+fun(x/10);

    
}
int main()
{   
    int n,digits;
    printf("Enter the number: ");
    scanf("%d",&n);
    digits= fun(n);
    printf("%d",digits);

    return 0;
}
